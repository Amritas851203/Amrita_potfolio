# Server Port
PORT=5000

# Environment Mode (development | production)
NODE_ENV=development

# MongoDB Connection String
# For local MongoDB: mongodb://127.0.0.1:27017/amrita_portfolio_cms
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/amrita_portfolio_cms?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/amrita_portfolio_cms

# JWT Secret Key and Expiry
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173
